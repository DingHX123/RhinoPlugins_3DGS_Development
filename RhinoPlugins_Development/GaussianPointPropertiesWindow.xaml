<Window
    x:Class="RhinoPlugins_Development.GaussianPointPropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="3DGS 高斯点属性查看器"
    Width="750"
    Height="620"
    MinWidth="500"
    MinHeight="400"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    Background="#FAFAFA">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="14,10"
            Background="#1976D2"
            CornerRadius="4">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="3DGS 高斯点椭球参数" />
                <TextBlock
                    x:Name="PointInfoText"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="#B3D4FC" />
            </StackPanel>
        </Border>

        <DataGrid
            Grid.Row="1"
            Margin="0,0,0,10"
            x:Name="PropertiesDataGrid"
            ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding Name}"
                    Header="属性名"
                    SortMemberPath="Name" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Description}"
                    Header="说明"
                    SortMemberPath="Description" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding RawValue}"
                    Header="原始值"
                    SortMemberPath="RawValue" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ComputedValue}"
                    Header="计算值"
                    SortMemberPath="ComputedValue" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <TextBlock
                x:Name="FilePathText"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="Gray"
                TextTrimming="CharacterEllipsis" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="OnCreateEllipsoid"
                    Content="创建椭球"
                    Background="#1976D2"
                    Foreground="White"
                    FontWeight="SemiBold" />
                <Button
                    Width="80"
                    Height="28"
                    Click="OnClose"
                    Content="关闭"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>